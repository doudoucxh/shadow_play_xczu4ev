set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)

if(NOT DEFINED VITIS_AARCH64_ROOT)
    message(FATAL_ERROR "Set VITIS_AARCH64_ROOT to Vitis gnu/aarch64/nt/aarch64-linux")
endif()
file(TO_CMAKE_PATH "${VITIS_AARCH64_ROOT}" VITIS_AARCH64_ROOT)
set(CMAKE_C_COMPILER "${VITIS_AARCH64_ROOT}/bin/aarch64-linux-gnu-gcc.exe")
set(CMAKE_CXX_COMPILER "${VITIS_AARCH64_ROOT}/bin/aarch64-linux-gnu-g++.exe")
set(CMAKE_SYSROOT "${VITIS_AARCH64_ROOT}/aarch64-xilinx-linux")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES VITIS_AARCH64_ROOT)
